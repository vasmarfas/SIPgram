FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libopus0 && rm -rf /var/lib/apt/lists/*
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir "ntgcalls>=3.0.2,<4" "telethon>=1.40" "numpy>=1.26" "PyYAML>=6.0" "aiohttp>=3.9" pytest pytest-asyncio
WORKDIR /app
